{
  "name": "multirotor-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multirotor flight simulator with cascaded PID control and automatic PID tuning",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.viewer.json --noEmit",
    "typecheck:core": "tsc --noEmit",
    "typecheck:viewer": "tsc -p tsconfig.viewer.json --noEmit",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "demo": "tsx scripts/dropBox.ts",
    "demo:hover": "tsx scripts/hoverDemo.ts",
    "demo:flight": "tsx scripts/flightDemo.ts",
    "demo:disturbance": "tsx scripts/disturbanceDemo.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
